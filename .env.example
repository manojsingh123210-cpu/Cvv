# ─────────────────────────────────────────────────────────────
# XYVEN PREMIUM REFER & EARN — Environment Template
# Copy this file to .env for local testing.
# NEVER commit the real .env file to Git.
# ─────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────
# Get from @BotFather → /mybots → your bot → API Token
BOT_TOKEN=your_bot_token_here

# Bot username WITHOUT the @ symbol, e.g. XyvenPremiumBot
BOT_USERNAME=your_bot_username_here

# Numeric Telegram user IDs (comma-separated, no spaces)
# Find your ID via @userinfobot on Telegram.
# Example: ADMIN_IDS=111111111,222222222
ADMIN_IDS=your_numeric_admin_id_here

# ── Database ─────────────────────────────────────────────────
# On Render with a persistent disk mounted at /var/data:
#   DATABASE_PATH=/var/data/xyven.db
# For local testing:
#   DATABASE_PATH=xyven.db
DATABASE_PATH=xyven.db

# ── Webhook (Render) ─────────────────────────────────────────
# Your Render service URL WITHOUT trailing slash.
# Example: https://xyven-bot.onrender.com
WEBHOOK_URL=https://your-service-name.onrender.com

# Long random string (32+ chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=generate_a_long_random_secret_here

# ── Website ──────────────────────────────────────────────────
# Same as WEBHOOK_URL in most cases.
WEBSITE_URL=https://your-service-name.onrender.com
